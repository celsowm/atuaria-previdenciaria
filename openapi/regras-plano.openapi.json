{
  "openapi": "3.1.0",
  "info": {
    "title": "Fragmento da API de regras de plano",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "RegrasPlano"
    }
  ],
  "paths": {
    "/api/planos/{planoId}/regras": {
      "get": {
        "tags": [
          "RegrasPlano"
        ],
        "operationId": "listarVersoesRegrasPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "planoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned plan rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResumoVersaoRegrasPlano"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "RegrasPlano"
        ],
        "operationId": "criarVersaoRegrasPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "planoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarVersaoRegrasPlano"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created draft plan rules version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersaoRegrasPlano"
                }
              }
            }
          }
        }
      }
    },
    "/api/regras-plano/{id}": {
      "get": {
        "tags": [
          "RegrasPlano"
        ],
        "operationId": "obterVersaoRegrasPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versão de regras do plano",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersaoRegrasPlano"
                }
              }
            }
          },
          "404": {
            "description": "Versão de regras do plano não encontrada"
          }
        }
      },
      "patch": {
        "tags": [
          "RegrasPlano"
        ],
        "operationId": "atualizarVersaoRegrasPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarVersaoRegrasPlano"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated draft plan rules version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersaoRegrasPlano"
                }
              }
            }
          }
        }
      }
    },
    "/api/regras-plano/{id}/valores": {
      "patch": {
        "tags": [
          "RegrasPlano"
        ],
        "operationId": "definirValoresRegrasPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefinirValorRegraPlano"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replaced active plan rule set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersaoRegrasPlano"
                }
              }
            }
          }
        }
      }
    },
    "/api/regras-plano/{id}/aprovar": {
      "post": {
        "tags": [
          "RegrasPlano"
        ],
        "operationId": "aprovarVersaoRegrasPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved immutable plan rules snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersaoRegrasPlano"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtualizarVersaoRegrasPlano": {
        "type": "object",
        "properties": {
          "vigenciaInicial": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "observacoes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "vigenciaFinal": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "DefinirValorRegraPlano": {
        "type": "object",
        "required": [
          "codigo",
          "categoria",
          "rotulo",
          "tipoValor",
          "jsonValor"
        ],
        "properties": {
          "tipoValor": {
            "type": "string",
            "enum": [
              "NUMBER",
              "INTEGER",
              "TEXT",
              "BOOLEAN"
            ]
          },
          "unidade": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "codigo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "jsonValor": {
            "type": "string",
            "minLength": 1
          },
          "origem": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "rotulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "ResumoVersaoRegrasPlano": {
        "type": "object",
        "required": [
          "id",
          "planoId",
          "versao",
          "nome",
          "modalidade",
          "situacao",
          "vigenciaInicial",
          "vigenciaFinal",
          "rulesFingerprint",
          "observacoes",
          "criadoEm",
          "atualizadoEm",
          "aprovadoEm"
        ],
        "properties": {
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "aprovadoEm": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "modalidade": {
            "type": "string",
            "enum": [
              "BD",
              "CD",
              "CV"
            ]
          },
          "observacoes": {
            "type": [
              "string",
              "null"
            ]
          },
          "versao": {
            "type": "integer",
            "minimum": 1
          },
          "atualizadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "nome": {
            "type": "string"
          },
          "planoId": {
            "type": "string",
            "format": "uuid"
          },
          "vigenciaFinal": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rulesFingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "situacao": {
            "type": "string",
            "enum": [
              "RASCUNHO",
              "APROVADO",
              "SUBSTITUIDO"
            ]
          },
          "vigenciaInicial": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CriarVersaoRegrasPlano": {
        "type": "object",
        "properties": {
          "vigenciaInicial": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "observacoes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "vigenciaFinal": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "copiarDeId": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "ValorRegraPlano": {
        "type": "object",
        "required": [
          "id",
          "codigo",
          "categoria",
          "rotulo",
          "tipoValor",
          "jsonValor",
          "unidade",
          "origem",
          "atualizadoEm"
        ],
        "properties": {
          "tipoValor": {
            "type": "string",
            "enum": [
              "NUMBER",
              "INTEGER",
              "TEXT",
              "BOOLEAN"
            ]
          },
          "unidade": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "atualizadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "codigo": {
            "type": "string"
          },
          "jsonValor": {
            "type": "string"
          },
          "origem": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "rotulo": {
            "type": "string"
          }
        }
      },
      "VersaoRegrasPlano": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResumoVersaoRegrasPlano"
          },
          {
            "type": "object",
            "required": [
              "regras"
            ],
            "properties": {
              "regras": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ValorRegraPlano"
                }
              }
            }
          }
        ]
      }
    }
  }
}
