{
  "tags": [{ "name": "Adherence" }],
  "paths": {
    "/api/adherence-studies/": {
      "get": {
        "tags": ["Adherence"],
        "operationId": "listAdherenceStudies",
        "responses": { "200": { "description": "Adherence studies", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AdherenceStudySummary" } } } } } }
      },
      "post": {
        "tags": ["Adherence"],
        "operationId": "createAdherenceStudy",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAdherenceStudy" } } } },
        "responses": { "201": { "description": "Executed adherence study", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdherenceStudyDetail" } } } } }
      }
    },
    "/api/adherence-studies/{id}": {
      "get": {
        "tags": ["Adherence"],
        "operationId": "getAdherenceStudy",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Adherence study detail", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdherenceStudyDetail" } } } } }
      }
    },
    "/api/adherence-candidates/{id}/points": {
      "get": {
        "tags": ["Adherence"],
        "operationId": "getAdherenceCandidatePoints",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Observed versus expected points", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdherenceCandidatePoints" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "AdherenceObservation": {
        "type": "object",
        "required": ["year", "age", "sex", "exposure", "observedEvents"],
        "properties": {
          "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
          "age": { "type": "integer", "minimum": 0, "maximum": 130 },
          "sex": { "type": "string", "enum": ["MALE", "FEMALE", "UNISEX"] },
          "exposure": { "type": "number", "exclusiveMinimum": 0 },
          "observedEvents": { "type": "integer", "minimum": 0 }
        }
      },
      "CreateAdherenceStudy": {
        "type": "object",
        "required": ["name", "hypothesisType", "periodStart", "periodEnd", "sexScope", "alpha", "fisherSplitAge", "candidateVersionIds", "observations"],
        "properties": {
          "evaluationId": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "hypothesisType": { "type": "string", "minLength": 1 },
          "periodStart": { "type": "integer", "minimum": 1900, "maximum": 2200 },
          "periodEnd": { "type": "integer", "minimum": 1900, "maximum": 2200 },
          "sexScope": { "type": "string", "enum": ["BOTH", "MALE", "FEMALE", "UNISEX"] },
          "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
          "fisherSplitAge": { "type": "integer", "minimum": 0, "maximum": 130 },
          "candidateVersionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
          "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/AdherenceObservation" } }
        }
      },
      "AdherenceStudySummary": {
        "type": "object",
        "required": ["id", "evaluationId", "name", "hypothesisType", "periodStart", "periodEnd", "sexScope", "alpha", "status", "engineVersion", "observationCount", "candidateCount", "createdAt", "completedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "evaluationId": { "type": ["integer", "null"] },
          "name": { "type": "string" },
          "hypothesisType": { "type": "string" },
          "periodStart": { "type": "integer" },
          "periodEnd": { "type": "integer" },
          "sexScope": { "type": "string" },
          "alpha": { "type": "number" },
          "status": { "type": "string" },
          "engineVersion": { "type": "string" },
          "observationCount": { "type": "integer" },
          "candidateCount": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "AdherenceCandidateResult": {
        "type": "object",
        "required": ["id", "biometricVersionId", "tableCode", "tableName", "versionLabel", "rank", "observedEvents", "expectedEvents", "chiSquare", "chiSquareDf", "chiSquareCritical", "chiSquareP", "chiSquarePass", "ksD", "ksCritical", "ksP", "ksPass", "zStatistic", "zCritical", "zP", "zPass", "fisherP", "fisherPass", "dqm", "rejectedTests"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "biometricVersionId": { "type": "string", "format": "uuid" },
          "tableCode": { "type": "string" },
          "tableName": { "type": "string" },
          "versionLabel": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 },
          "observedEvents": { "type": "number", "minimum": 0 },
          "expectedEvents": { "type": "number", "minimum": 0 },
          "chiSquare": { "type": "number", "minimum": 0 },
          "chiSquareDf": { "type": "integer", "minimum": 1 },
          "chiSquareCritical": { "type": "number", "minimum": 0 },
          "chiSquareP": { "type": "number", "minimum": 0, "maximum": 1 },
          "chiSquarePass": { "type": "boolean" },
          "ksD": { "type": "number", "minimum": 0, "maximum": 1 },
          "ksCritical": { "type": "number", "minimum": 0, "maximum": 1 },
          "ksP": { "type": "number", "minimum": 0, "maximum": 1 },
          "ksPass": { "type": "boolean" },
          "zStatistic": { "type": "number" },
          "zCritical": { "type": "number", "minimum": 0 },
          "zP": { "type": "number", "minimum": 0, "maximum": 1 },
          "zPass": { "type": "boolean" },
          "fisherP": { "type": "number", "minimum": 0, "maximum": 1 },
          "fisherPass": { "type": "boolean" },
          "dqm": { "type": "number", "minimum": 0 },
          "rejectedTests": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      },
      "AdherenceStudyDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/AdherenceStudySummary" },
          { "type": "object", "required": ["fisherSplitAge", "candidates"], "properties": {
            "fisherSplitAge": { "type": "integer" },
            "candidates": { "type": "array", "items": { "$ref": "#/components/schemas/AdherenceCandidateResult" } }
          } }
        ]
      },
      "AdherenceCandidatePoint": {
        "type": "object",
        "required": ["age", "sex", "exposure", "observedEvents", "qx", "expectedEvents", "residual"],
        "properties": {
          "age": { "type": "integer" },
          "sex": { "type": "string" },
          "exposure": { "type": "number", "exclusiveMinimum": 0 },
          "observedEvents": { "type": "integer", "minimum": 0 },
          "qx": { "type": "number", "minimum": 0, "maximum": 1 },
          "expectedEvents": { "type": "number", "minimum": 0 },
          "residual": { "type": "number" }
        }
      },
      "AdherenceCandidatePoints": {
        "type": "object",
        "required": ["candidate", "points"],
        "properties": {
          "candidate": { "$ref": "#/components/schemas/AdherenceCandidateResult" },
          "points": { "type": "array", "items": { "$ref": "#/components/schemas/AdherenceCandidatePoint" } }
        }
      }
    }
  }
}
