{
  "tags": [
    {
      "name": "Aderencia"
    }
  ],
  "paths": {
    "/api/estudos-aderencia/": {
      "get": {
        "tags": [
          "Aderencia"
        ],
        "operationId": "listarEstudosAderencia",
        "responses": {
          "200": {
            "description": "Estudos de aderência",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResumoEstudoAderencia"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Aderencia"
        ],
        "operationId": "criarEstudoAderencia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarEstudoAderencia"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Executed adherence study",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalheEstudoAderencia"
                }
              }
            }
          }
        }
      }
    },
    "/api/estudos-aderencia/{id}": {
      "get": {
        "tags": [
          "Aderencia"
        ],
        "operationId": "obterEstudoAderencia",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do estudo de aderência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalheEstudoAderencia"
                }
              }
            }
          }
        }
      }
    },
    "/api/candidatos-aderencia/{id}/pontos": {
      "get": {
        "tags": [
          "Aderencia"
        ],
        "operationId": "obterPontosCandidatoAderencia",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed versus expected points",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PontosCandidatoAderencia"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResultadoCandidatoAderencia": {
        "type": "object",
        "required": [
          "id",
          "versaoBiometriaId",
          "codigoTabua",
          "nomeTabua",
          "rotuloVersao",
          "posicao",
          "eventosObservados",
          "eventosEsperados",
          "quiQuadrado",
          "quiQuadradoDf",
          "quiQuadradoCritico",
          "quiQuadradoP",
          "quiQuadradoPass",
          "ksD",
          "ksCritico",
          "pKs",
          "pKsPass",
          "estatisticaZ",
          "zCritico",
          "pZ",
          "pZPass",
          "pFisher",
          "pFisherPass",
          "dqm",
          "testesRejeitados"
        ],
        "properties": {
          "zCritico": {
            "type": "number",
            "minimum": 0
          },
          "rotuloVersao": {
            "type": "string"
          },
          "pFisherPass": {
            "type": "boolean"
          },
          "quiQuadradoP": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "quiQuadradoPass": {
            "type": "boolean"
          },
          "nomeTabua": {
            "type": "string"
          },
          "eventosObservados": {
            "type": "number",
            "minimum": 0
          },
          "pKsPass": {
            "type": "boolean"
          },
          "estatisticaZ": {
            "type": "number"
          },
          "versaoBiometriaId": {
            "type": "string",
            "format": "uuid"
          },
          "codigoTabua": {
            "type": "string"
          },
          "pZPass": {
            "type": "boolean"
          },
          "pKs": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dqm": {
            "type": "number",
            "minimum": 0
          },
          "pFisher": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "eventosEsperados": {
            "type": "number",
            "minimum": 0
          },
          "quiQuadradoDf": {
            "type": "integer",
            "minimum": 1
          },
          "posicao": {
            "type": "integer",
            "minimum": 1
          },
          "ksD": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "quiQuadradoCritico": {
            "type": "number",
            "minimum": 0
          },
          "pZ": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ksCritico": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "quiQuadrado": {
            "type": "number",
            "minimum": 0
          },
          "testesRejeitados": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      },
      "ResumoEstudoAderencia": {
        "type": "object",
        "required": [
          "id",
          "avaliacaoId",
          "nome",
          "tipoHipotese",
          "periodoInicial",
          "periodoFinal",
          "escopoSexo",
          "alpha",
          "situacao",
          "versaoMotor",
          "quantidadeObservacoes",
          "quantidadeCandidatos",
          "criadoEm",
          "concluidoEm"
        ],
        "properties": {
          "periodoFinal": {
            "type": "integer"
          },
          "avaliacaoId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "alpha": {
            "type": "number"
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "versaoMotor": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quantidadeObservacoes": {
            "type": "integer"
          },
          "concluidoEm": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "periodoInicial": {
            "type": "integer"
          },
          "quantidadeCandidatos": {
            "type": "integer"
          },
          "escopoSexo": {
            "type": "string"
          },
          "situacao": {
            "type": "string"
          },
          "tipoHipotese": {
            "type": "string"
          }
        }
      },
      "PontoCandidatoAderencia": {
        "type": "object",
        "required": [
          "idade",
          "sexo",
          "exposicao",
          "eventosObservados",
          "qx",
          "eventosEsperados",
          "residuo"
        ],
        "properties": {
          "residuo": {
            "type": "number"
          },
          "eventosObservados": {
            "type": "integer",
            "minimum": 0
          },
          "idade": {
            "type": "integer"
          },
          "eventosEsperados": {
            "type": "number",
            "minimum": 0
          },
          "sexo": {
            "type": "string"
          },
          "exposicao": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "qx": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "ObservacaoAderencia": {
        "type": "object",
        "required": [
          "ano",
          "idade",
          "sexo",
          "exposicao",
          "eventosObservados"
        ],
        "properties": {
          "sexo": {
            "type": "string",
            "enum": [
              "MASCULINO",
              "FEMININO",
              "UNISSEX"
            ]
          },
          "ano": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "idade": {
            "type": "integer",
            "minimum": 0,
            "maximum": 130
          },
          "exposicao": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "eventosObservados": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CriarEstudoAderencia": {
        "type": "object",
        "required": [
          "nome",
          "tipoHipotese",
          "periodoInicial",
          "periodoFinal",
          "escopoSexo",
          "alpha",
          "idadeDivisaoFisher",
          "idsVersoesCandidatas",
          "observacoes"
        ],
        "properties": {
          "observacoes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ObservacaoAderencia"
            }
          },
          "avaliacaoId": {
            "type": "integer",
            "minimum": 1
          },
          "alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "idsVersoesCandidatas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "escopoSexo": {
            "type": "string",
            "enum": [
              "AMBOS",
              "MASCULINO",
              "FEMININO",
              "UNISSEX"
            ]
          },
          "periodoInicial": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "periodoFinal": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "tipoHipotese": {
            "type": "string",
            "minLength": 1
          },
          "idadeDivisaoFisher": {
            "type": "integer",
            "minimum": 0,
            "maximum": 130
          }
        }
      },
      "PontosCandidatoAderencia": {
        "type": "object",
        "required": [
          "candidate",
          "pontos"
        ],
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/ResultadoCandidatoAderencia"
          },
          "pontos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PontoCandidatoAderencia"
            }
          }
        }
      },
      "DetalheEstudoAderencia": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResumoEstudoAderencia"
          },
          {
            "type": "object",
            "required": [
              "idadeDivisaoFisher",
              "candidatos"
            ],
            "properties": {
              "idadeDivisaoFisher": {
                "type": "integer"
              },
              "candidatos": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ResultadoCandidatoAderencia"
                }
              }
            }
          }
        ]
      }
    }
  }
}
