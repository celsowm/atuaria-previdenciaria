    "/api/importacoes/": {
      "post": {
        "tags": [
          "EstudioDados"
        ],
        "operationId": "criarImportacao",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "populacao",
                  "linhaCabecalho",
                  "regrasJson"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "populacao": {
                    "type": "string"
                  },
                  "avaliacaoId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "perfilMapeamentoId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "nomePerfil": {
                    "type": "string"
                  },
                  "salvarPerfil": {
                    "type": "boolean"
                  },
                  "nomeAba": {
                    "type": "string"
                  },
                  "linhaCabecalho": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "regrasJson": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted import",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoImportacao"
                }
              }
            }
          }
        }
      }
    },
