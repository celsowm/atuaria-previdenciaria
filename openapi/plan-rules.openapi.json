{
  "openapi": "3.1.0",
  "info": {
    "title": "Plan Rules API fragment",
    "version": "0.0.1"
  },
  "tags": [{ "name": "Plan Rules" }],
  "paths": {
    "/api/plans/{planId}/rules": {
      "get": {
        "tags": ["Plan Rules"],
        "operationId": "listPlanRulesVersions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "planId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "Versioned plan rules",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PlanRulesVersionSummary" } } } }
          }
        }
      },
      "post": {
        "tags": ["Plan Rules"],
        "operationId": "createPlanRulesVersion",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "planId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePlanRulesVersion" } } } },
        "responses": {
          "201": { "description": "Created draft plan rules version", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanRulesVersion" } } } }
        }
      }
    },
    "/api/plan-rules/{id}": {
      "get": {
        "tags": ["Plan Rules"],
        "operationId": "getPlanRulesVersion",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Plan rules version", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanRulesVersion" } } } },
          "404": { "description": "Plan rules version not found" }
        }
      },
      "patch": {
        "tags": ["Plan Rules"],
        "operationId": "updatePlanRulesVersion",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePlanRulesVersion" } } } },
        "responses": {
          "200": { "description": "Updated draft plan rules version", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanRulesVersion" } } } }
        }
      }
    },
    "/api/plan-rules/{id}/values": {
      "patch": {
        "tags": ["Plan Rules"],
        "operationId": "setPlanRuleValues",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetPlanRuleValues" } } } },
        "responses": {
          "200": { "description": "Replaced active plan rule set", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanRulesVersion" } } } }
        }
      }
    },
    "/api/plan-rules/{id}/approve": {
      "post": {
        "tags": ["Plan Rules"],
        "operationId": "approvePlanRulesVersion",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Approved immutable plan rules snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanRulesVersion" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlanRuleValue": {
        "type": "object",
        "required": ["id", "code", "category", "label", "valueType", "valueJson", "unit", "source", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "category": { "type": "string" },
          "label": { "type": "string" },
          "valueType": { "type": "string", "enum": ["NUMBER", "INTEGER", "TEXT", "BOOLEAN"] },
          "valueJson": { "type": "string" },
          "unit": { "type": ["string", "null"] },
          "source": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PlanRulesVersionSummary": {
        "type": "object",
        "required": ["id", "planId", "version", "name", "modality", "status", "effectiveFrom", "effectiveTo", "rulesFingerprint", "notes", "createdAt", "updatedAt", "approvedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "planId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "modality": { "type": "string", "enum": ["BD", "CD", "CV"] },
          "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "SUPERSEDED"] },
          "effectiveFrom": { "type": ["string", "null"], "format": "date" },
          "effectiveTo": { "type": ["string", "null"], "format": "date" },
          "rulesFingerprint": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "approvedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "PlanRulesVersion": {
        "allOf": [
          { "$ref": "#/components/schemas/PlanRulesVersionSummary" },
          {
            "type": "object",
            "required": ["rules"],
            "properties": {
              "rules": { "type": "array", "items": { "$ref": "#/components/schemas/PlanRuleValue" } }
            }
          }
        ]
      },
      "CreatePlanRulesVersion": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "effectiveFrom": { "type": ["string", "null"], "format": "date" },
          "effectiveTo": { "type": ["string", "null"], "format": "date" },
          "notes": { "type": ["string", "null"], "maxLength": 4000 },
          "copyFromId": { "type": "string", "format": "uuid" }
        }
      },
      "UpdatePlanRulesVersion": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "effectiveFrom": { "type": ["string", "null"], "format": "date" },
          "effectiveTo": { "type": ["string", "null"], "format": "date" },
          "notes": { "type": ["string", "null"], "maxLength": 4000 }
        }
      },
      "SetPlanRuleValue": {
        "type": "object",
        "required": ["code", "category", "label", "valueType", "valueJson"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 120 },
          "category": { "type": "string", "minLength": 1, "maxLength": 120 },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "valueType": { "type": "string", "enum": ["NUMBER", "INTEGER", "TEXT", "BOOLEAN"] },
          "valueJson": { "type": "string", "minLength": 1 },
          "unit": { "type": ["string", "null"], "maxLength": 60 },
          "source": { "type": ["string", "null"], "maxLength": 200 }
        }
      },
      "SetPlanRuleValues": {
        "type": "object",
        "required": ["rules"],
        "properties": {
          "rules": { "type": "array", "items": { "$ref": "#/components/schemas/SetPlanRuleValue" } }
        }
      }
    }
  }
}
