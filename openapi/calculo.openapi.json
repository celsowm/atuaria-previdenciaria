{
  "openapi": "3.1.0",
  "info": {
    "title": "Fragmento da API de cálculos da Atuária Previdenciária",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "Calculo"
    }
  ],
  "paths": {
    "/api/motores-calculo": {
      "get": {
        "tags": [
          "Calculo"
        ],
        "operationId": "listarMotoresCalculo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Registered calculation engines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MotorCalculo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/avaliacoes/{avaliacaoId}/calculos": {
      "get": {
        "tags": [
          "Calculo"
        ],
        "operationId": "listarExecucoesCalculo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "avaliacaoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Execuções de cálculo de uma avaliação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResumoExecucaoCalculo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Calculo"
        ],
        "operationId": "criarExecucaoCalculo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "avaliacaoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarExecucaoCalculo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Executed or reused deterministic calculation run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecucaoCalculo"
                }
              }
            }
          }
        }
      }
    },
    "/api/calculos/{id}": {
      "get": {
        "tags": [
          "Calculo"
        ],
        "operationId": "obterExecucaoCalculo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete immutable calculation run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecucaoCalculo"
                }
              }
            }
          },
          "404": {
            "description": "Execução de cálculo não encontrada"
          }
        }
      }
    },
    "/api/calculos/{id}/participantes": {
      "get": {
        "tags": [
          "Calculo"
        ],
        "operationId": "listarParticipantesCalculo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged participant reconciliation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResultadosParticipantesCalculo"
                }
              }
            }
          },
          "404": {
            "description": "Execução de cálculo não encontrada"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EntradaCalculo": {
        "type": "object",
        "required": [
          "id",
          "importacaoId",
          "populacao",
          "arquivoSha256",
          "schemaFingerprint",
          "impressaoDigitalCanonica",
          "quantidadeLinhas",
          "linhasValidas",
          "linhasInvalidas",
          "importedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "linhasInvalidas": {
            "type": "integer",
            "minimum": 0
          },
          "impressaoDigitalCanonica": {
            "type": "string"
          },
          "arquivoSha256": {
            "type": "string"
          },
          "quantidadeLinhas": {
            "type": "integer",
            "minimum": 0
          },
          "importedAt": {
            "type": "string",
            "format": "date-time"
          },
          "linhasValidas": {
            "type": "integer",
            "minimum": 0
          },
          "populacao": {
            "type": "string"
          },
          "importacaoId": {
            "type": "string",
            "format": "uuid"
          },
          "schemaFingerprint": {
            "type": "string"
          }
        }
      },
      "MotorCalculo": {
        "type": "object",
        "required": [
          "codigo",
          "versao",
          "rotulo",
          "descricao",
          "tipoResultado",
          "exigeRegrasPlano",
          "modalidadesSuportadas"
        ],
        "properties": {
          "modalidadesSuportadas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "BD",
                "CD",
                "CV"
              ]
            }
          },
          "descricao": {
            "type": "string"
          },
          "tipoResultado": {
            "type": "string",
            "enum": [
              "PRECALCULO",
              "ATUARIAL"
            ]
          },
          "codigo": {
            "type": "string"
          },
          "exigeRegrasPlano": {
            "type": "boolean"
          },
          "versao": {
            "type": "string"
          },
          "rotulo": {
            "type": "string"
          }
        }
      },
      "PaginaResultadosParticipantesCalculo": {
        "type": "object",
        "required": [
          "items",
          "totalItems",
          "page",
          "pageSize"
        ],
        "properties": {
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultadoParticipanteCalculo"
            }
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "ResultadoParticipanteCalculo": {
        "type": "object",
        "required": [
          "id",
          "importacaoId",
          "populacao",
          "numeroLinhaOrigem",
          "matriculaParticipante",
          "jsonResultado",
          "ordem"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jsonResultado": {
            "type": "string"
          },
          "ordem": {
            "type": "integer",
            "minimum": 0
          },
          "populacao": {
            "type": "string"
          },
          "numeroLinhaOrigem": {
            "type": "integer",
            "minimum": 1
          },
          "importacaoId": {
            "type": "string",
            "format": "uuid"
          },
          "matriculaParticipante": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CriarExecucaoCalculo": {
        "type": "object",
        "required": [
          "parametrizacaoId"
        ],
        "properties": {
          "codigoMotor": {
            "type": "string",
            "minLength": 1
          },
          "parametrizacaoId": {
            "type": "string",
            "format": "uuid"
          },
          "versaoRegrasPlanoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ResumoExecucaoCalculo": {
        "type": "object",
        "required": [
          "id",
          "avaliacaoId",
          "parametrizacaoId",
          "versaoRegrasPlanoId",
          "planRulesFingerprint",
          "codigoMotor",
          "versaoMotor",
          "situacao",
          "impressaoDigitalEntrada",
          "impressaoDigitalResultado",
          "quantidadeImportacoesEntrada",
          "quantidadeLinhasEntrada",
          "quantidadeLinhasValidas",
          "quantidadeLinhasInvalidas",
          "quantidadeResultadosParticipantes",
          "criadoEm",
          "concluidoEm",
          "mensagemErro"
        ],
        "properties": {
          "concluidoEm": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "avaliacaoId": {
            "type": "integer",
            "minimum": 1
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "parametrizacaoId": {
            "type": "string",
            "format": "uuid"
          },
          "quantidadeLinhasEntrada": {
            "type": "integer",
            "minimum": 0
          },
          "versaoMotor": {
            "type": "string"
          },
          "planRulesFingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "impressaoDigitalEntrada": {
            "type": "string"
          },
          "versaoRegrasPlanoId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "quantidadeResultadosParticipantes": {
            "type": "integer",
            "minimum": 0
          },
          "impressaoDigitalResultado": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantidadeLinhasValidas": {
            "type": "integer",
            "minimum": 0
          },
          "quantidadeLinhasInvalidas": {
            "type": "integer",
            "minimum": 0
          },
          "situacao": {
            "type": "string",
            "enum": [
              "PROCESSANDO",
              "CONCLUIDO",
              "FALHO"
            ]
          },
          "mensagemErro": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quantidadeImportacoesEntrada": {
            "type": "integer",
            "minimum": 0
          },
          "codigoMotor": {
            "type": "string"
          }
        }
      },
      "MetricaResultadoCalculo": {
        "type": "object",
        "required": [
          "id",
          "codigo",
          "categoria",
          "rotulo",
          "tipoValor",
          "jsonValor",
          "unidade",
          "ordem"
        ],
        "properties": {
          "tipoValor": {
            "type": "string",
            "enum": [
              "NUMBER",
              "INTEGER",
              "TEXT",
              "BOOLEAN"
            ]
          },
          "unidade": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "codigo": {
            "type": "string"
          },
          "jsonValor": {
            "type": "string"
          },
          "ordem": {
            "type": "integer",
            "minimum": 0
          },
          "categoria": {
            "type": "string"
          },
          "rotulo": {
            "type": "string"
          }
        }
      },
      "ExecucaoCalculo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResumoExecucaoCalculo"
          },
          {
            "type": "object",
            "required": [
              "impressaoDigitalParametros",
              "impressaoDigitalDados",
              "entradas",
              "metricas"
            ],
            "properties": {
              "impressaoDigitalParametros": {
                "type": "string"
              },
              "impressaoDigitalDados": {
                "type": "string"
              },
              "entradas": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EntradaCalculo"
                }
              },
              "metricas": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MetricaResultadoCalculo"
                }
              }
            }
          }
        ]
      }
    }
  }
}
