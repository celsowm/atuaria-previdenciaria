{
  "openapi": "3.1.0",
  "info": {
    "title": "Authentication API fragment",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "Autenticacao"
    },
    {
      "name": "Usuarios"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitacaoLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaLogin"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Autenticacao"
        ],
        "operationId": "usuarioAtual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioAutenticado"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired session"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaLogout"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "listarUsuarios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioAutenticado"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required"
          }
        }
      },
      "post": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "criarUsuario",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarUsuario"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioAutenticado"
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required"
          }
        }
      }
    },
    "/api/users/{id}": {
      "patch": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "atualizarUsuario",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarUsuario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioAutenticado"
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RespostaLogout": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "RespostaLogin": {
        "type": "object",
        "required": [
          "token",
          "expiraEm",
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UsuarioAutenticado"
          },
          "expiraEm": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "AtualizarUsuario": {
        "type": "object",
        "properties": {
          "ativo": {
            "type": "boolean"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "admin",
              "actuary",
              "reviewer"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 10
          },
          "nomeExibicao": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "SolicitacaoLogin": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "UsuarioAutenticado": {
        "type": "object",
        "required": [
          "id",
          "email",
          "nomeExibicao",
          "perfil",
          "ativo",
          "criadoEm",
          "atualizadoEm",
          "ultimoAcessoEm"
        ],
        "properties": {
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "admin",
              "actuary",
              "reviewer"
            ]
          },
          "nomeExibicao": {
            "type": "string"
          },
          "ultimoAcessoEm": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "atualizadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "CriarUsuario": {
        "type": "object",
        "required": [
          "email",
          "nomeExibicao",
          "password",
          "perfil"
        ],
        "properties": {
          "perfil": {
            "type": "string",
            "enum": [
              "admin",
              "actuary",
              "reviewer"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 10
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "nomeExibicao": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
