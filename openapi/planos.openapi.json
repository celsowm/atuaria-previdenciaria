{
  "openapi": "3.1.0",
  "info": {
    "title": "Fragmento da API de planos",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "Planos"
    }
  ],
  "paths": {
    "/api/planos/": {
      "get": {
        "tags": [
          "Planos"
        ],
        "operationId": "listarPlanos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Planos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plano"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Planos"
        ],
        "operationId": "criarPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarPlano"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plano"
                }
              }
            }
          }
        }
      }
    },
    "/api/planos/{id}": {
      "get": {
        "tags": [
          "Planos"
        ],
        "operationId": "obterPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plano",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plano"
                }
              }
            }
          },
          "404": {
            "description": "Plano não encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Planos"
        ],
        "operationId": "atualizarPlano",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarPlano"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plano"
                }
              }
            }
          },
          "404": {
            "description": "Plano não encontrado"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CriarPlano": {
        "type": "object",
        "required": [
          "codigo",
          "nome",
          "modalidade"
        ],
        "properties": {
          "cnpj": {
            "type": "string",
            "maxLength": 20
          },
          "nomePatrocinador": {
            "type": "string",
            "maxLength": 200
          },
          "modalidade": {
            "type": "string",
            "enum": [
              "BD",
              "CD",
              "CV"
            ]
          },
          "codigo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "Plano": {
        "type": "object",
        "required": [
          "id",
          "codigo",
          "nome",
          "modalidade",
          "nomePatrocinador",
          "cnpj",
          "situacao",
          "criadoEm",
          "atualizadoEm"
        ],
        "properties": {
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "cnpj": {
            "type": [
              "string",
              "null"
            ]
          },
          "nomePatrocinador": {
            "type": [
              "string",
              "null"
            ]
          },
          "atualizadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "nome": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "situacao": {
            "type": "string",
            "enum": [
              "ATIVO",
              "INATIVO",
              "ENCERRADO"
            ]
          },
          "modalidade": {
            "type": "string",
            "enum": [
              "BD",
              "CD",
              "CV"
            ]
          }
        }
      },
      "AtualizarPlano": {
        "type": "object",
        "properties": {
          "cnpj": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "nomePatrocinador": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "codigo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "situacao": {
            "type": "string",
            "enum": [
              "ATIVO",
              "INATIVO",
              "ENCERRADO"
            ]
          },
          "modalidade": {
            "type": "string",
            "enum": [
              "BD",
              "CD",
              "CV"
            ]
          }
        }
      }
    }
  }
}
