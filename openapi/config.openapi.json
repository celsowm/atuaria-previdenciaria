{
  "openapi": "3.1.0",
  "info": {
    "title": "Application Configuration API fragment",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "Sistema"
    }
  ],
  "paths": {
    "/api/config": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "operationId": "obterConfiguracaoAplicacao",
        "responses": {
          "200": {
            "description": "Public runtime branding and deployment configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracaoAplicacao"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfiguracaoAplicacao": {
        "type": "object",
        "required": [
          "nome",
          "shortName",
          "organizationName"
        ],
        "properties": {
          "organizationName": {
            "type": [
              "string",
              "null"
            ]
          },
          "shortName": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      }
    }
  }
}
