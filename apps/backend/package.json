{
  "name": "@atuaria-previdenciaria/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "adherence:golden:inspect": "tsx src/adherence/golden-master.ts inspect",
    "adherence:golden:compare": "tsx src/adherence/golden-master.ts compare",
    "adherence:golden:self-test": "tsx src/adherence/golden-master.ts self-test"
  },
  "dependencies": {
    "adorn-api": "^1.1.19",
    "metal-orm": "^1.1.28",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
