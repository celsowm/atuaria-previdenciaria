PORT=3001
ATUAS_DB_PATH=./data/atuas.sqlite
ATUAS_STORAGE_PATH=./data/storage

# First local administrator. Used only when the users table is empty.
ATUAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ATUAS_BOOTSTRAP_ADMIN_PASSWORD=change-this-password
ATUAS_BOOTSTRAP_ADMIN_NAME=Administrador ATUAS

# Opaque bearer session lifetime.
ATUAS_SESSION_TTL_DAYS=7

# Optional development/demo content. Keep false in production.
ATUAS_SEED_DEMO=false

# LLM credential references used only by the optional demo seed.
# Never commit real API keys.
ATUAS_PGE_LLM_KEY_1=
ATUAS_PGE_LLM_KEY_2=
ATUAS_PGE_LLM_KEY_3=
ATUAS_OPENAI_KEY_1=