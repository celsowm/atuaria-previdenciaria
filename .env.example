PORT=3001

# Runtime branding. Change these per deployment/entity without changing code.
APP_NAME=Plataforma Atuarial
APP_SHORT_NAME=Atuária
APP_ORGANIZATION_NAME=

# Persistent runtime data. Relative paths are resolved from the repository root.
APP_DB_PATH=./data/actuarial.sqlite
APP_STORAGE_PATH=./data/storage

# First local administrator. Used only when the users table is empty.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Administrador

# Opaque bearer session lifetime.
APP_SESSION_TTL_DAYS=7

# Optional development/demo content. Keep false in production.
APP_SEED_DEMO=false

# Credential references used only by the optional demo seed.
# Never commit real API keys.
APP_LLM_KEY_1=
APP_LLM_KEY_2=
APP_LLM_KEY_3=
OPENAI_API_KEY=